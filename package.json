{
  "name": "web-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "preview:ui": "vite --config vite.preview.config.mjs --host 127.0.0.1 --port 4174",
    "preview:ui:build": "vite build --config vite.preview.config.mjs",
    "build": "node tools/build.mjs",
    "financial:check": "node tools/check-financial-calculations.mjs",
    "financial:report": "node tools/generate-financial-audit-report.mjs",
    "preview": "vite preview --host :: --port 3000",
    "lint": "eslint . --quiet",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:functions": "supabase functions list",
    "supabase:dump:schema": "supabase db dump --schema public --file supabase/migrations/00000000000000_baseline.sql",
    "supabase:dump:seed": "supabase db dump --data-only --schema public --file supabase/seed.sql",
    "supabase:anonymize-seed": "node tools/anonymize-seed.mjs",
    "backend:check": "node tools/check-backend-env.mjs",
    "vendor:import-sql": "node tools/import-supplier-price-export.mjs",
    "migrations:check": "node tools/check-supabase-migrations.mjs",
    "test:critical": "node tools/check-critical-invariants.mjs",
    "security:check": "node tools/check-security-invariants.mjs",
    "ui:check": "node tools/check-ui-invariants.mjs",
    "test:workflows": "node --test tests/*.test.mjs && node tools/check-operations-workflows.mjs && node tools/check-unsaved-workflows.mjs && node tools/test-security-stabilization.mjs",
    "test:preview": "node src/preview/test-preview.mjs",
    "test": "eslint . --quiet && node tools/check-supabase-migrations.mjs && node tools/check-financial-calculations.mjs && node tools/check-critical-invariants.mjs && node tools/check-security-invariants.mjs && node tools/check-ui-invariants.mjs && npm run test:workflows"
  },
