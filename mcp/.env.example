# URL projektu Supabase. Lze použít i VITE_SUPABASE_URL z portálu.
EKV_PORTAL_SUPABASE_URL=https://your-project.supabase.co

# Veřejný anon key Supabase. Lze použít i VITE_SUPABASE_ANON_KEY.
EKV_PORTAL_SUPABASE_ANON_KEY=replace-me

# Pro agenta doporučeno: jednou spusťte `pnpm auth:login`. MCP pak načte a automaticky
# obnovuje relaci technického uživatele ze systémově chráněného souboru.
EKV_PORTAL_USE_STORED_SESSION=true
# EKV_PORTAL_SESSION_FILE=C:\secure\ekv-portal-mcp-session.json

# Pouze dočasná alternativa pro krátké testy; JWT obvykle rychle expiruje.
# EKV_PORTAL_SUPABASE_ACCESS_TOKEN=replace-me

# Volitelný jednorázový bootstrap pro automatizované nasazení. Po prvním obnovení
# se rotovaný refresh token uloží do EKV_PORTAL_SESSION_FILE; nevkládejte jej do repozitáře.
# EKV_PORTAL_SUPABASE_REFRESH_TOKEN=replace-me

# Zápisové nástroje se registrují jen při true a pouze s uživatelskou relací.
EKV_PORTAL_ENABLE_WRITES=true

# Finance přes service role jsou z důvodu citlivosti standardně zakázané.
EKV_PORTAL_ALLOW_SERVICE_ROLE_FINANCE=false

# Volitelné provozní nastavení.
EKV_PORTAL_REQUEST_TIMEOUT_MS=15000
EKV_PORTAL_MAX_RESPONSE_CHARS=25000
