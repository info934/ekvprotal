{
  "name": "ekv-portal-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for EKV Portal CRM, planning, meeting notes, tasks and finance monitoring",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ekv-portal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth:login": "pnpm run build && node dist/auth/cli.js login",
    "auth:status": "pnpm run build && node dist/auth/cli.js status",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  }
}
